# Base URL of the KnowRAG backend API.
#   http://localhost:8000  -> the `app` container (docker compose up -d)
#   http://localhost:8001  -> a host-side `uvicorn --reload` dev server
# Validated at startup by src/config/env.ts; the app fails loudly if this is
# not a valid absolute URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Copy this file to .env (repo root) or app/.env — app/core/config.py's Settings
# reads either location. Fill in real values; never commit the filled-in file.

# --- Required, no default ---
DATABASE_URL=postgresql://user:password@localhost:5432/knowrag
GEMINI_API_KEY=your-key-here

# --- Optional (defaults shown are what Settings falls back to) ---

# Qdrant. QDRANT_URL/QDRANT_API_KEY are the current names; the legacy names
# QURL/QAPI used elsewhere in this codebase are also accepted so an existing
# .env keeps working unchanged.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# Elasticsearch
ES_URL=http://localhost:9200

# Index/collection names (keep in sync across Qdrant + Elasticsearch)
QDRANT_COLLECTION=knowrag
ES_INDEX=knowrag

# Models
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM — LLM_PROVIDER selects which client app/infrastructure/llm/ calls: "gemini" or
# "openai". Only the selected provider's key is required; each client is
# constructed lazily, so an OpenAI-only or Gemini-only .env both start cleanly.
LLM_PROVIDER=gemini

# gemini-2.5-flash returns 404 for keys created after ~2026-08 ("no longer
# available to new users"), so it is not a working value on a new key.
GEMINI_MODEL=gemini-3.6-flash

# OpenAI. gpt-4o-mini is chosen on cost, not benchmark quality: at $0.15/M
# input + $0.60/M output (as published 2026-08-03) this workload's ~3.5K
# input-dominated tokens per call cost ~$0.0006-0.0011, i.e. 4.4K-8.8K calls
# for $5 — hundreds of full eval-suite runs. gpt-4o is ~20x that per call
# (~300 calls for $5) and does not cover the suite; redo the math before
# changing this.
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Retrieval / verification tuning
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
CLAIM_VERIFICATION_THRESHOLD=0.55
